# Storeganise Admin API key.
# Create one in the Storeganise admin app under Settings > Developer
# (requires the "manager" role). Do not commit the real value.
STOREGANISE_API_KEY=

# Only needed if your Storeganise instance is not the default spacehub.storeganise.com
# STOREGANISE_BASE_URL=https://spacehub.storeganise.com/api

# --- Login (Google OAuth, restricted to @spacehub.id) ---

# Random secret used to encrypt sessions. Generate one with:
#   npx auth secret
# or: openssl rand -base64 33
AUTH_SECRET=

# OAuth client credentials from Google Cloud Console
# (APIs & Services > Credentials > Create OAuth client ID > Web application).
# Authorized redirect URI must be: <your-deployed-url>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
